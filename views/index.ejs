<%- include('partials/header') %>

  <!-- Loading Overlay -->
  <div class="loading-overlay" id="loadingOverlay">
    <div class="spinner"></div>
  </div>

  <!-- Weather Signature Background Effect -->
  <div class="weather-signature-bg">
    <% if (typeof weather !== 'undefined' && weather) { %>
      <% if (weather.theme === 'day') { %>
        <div class="sky-effect sky-effect--day">
          <div class="sun-glow"></div>
          <div class="cloud cloud-1"></div>
          <div class="cloud cloud-2"></div>
        </div>
      <% } else if (weather.theme === 'sunset') { %>
        <div class="sky-effect sky-effect--sunset">
          <div class="sunset-glow"></div>
          <div class="horizon-glow"></div>
        </div>
      <% } else if (weather.theme === 'night') { %>
        <div class="sky-effect sky-effect--night">
          <div class="star star-1"></div>
          <div class="star star-2"></div>
          <div class="star star-3"></div>
          <div class="star star-4"></div>
          <div class="star star-5"></div>
          <div class="moon-glow"></div>
        </div>
      <% } %>
    <% } else { %>
      <div class="sky-effect sky-effect--default">
        <div class="default-ambient"></div>
      </div>
    <% } %>
    <% if (typeof weather !== 'undefined' && weather && weather.scene) { %>
      <canvas class="ambient-particles" id="ambientParticles" data-particles="<%= weather.scene.particles %>" aria-hidden="true"></canvas>
    <% } %>
  </div>

  <div class="app-wrapper">
    <div class="container">

      <!-- Header -->
      <header class="app-header">
        <div class="app-header__logo">
          <i class="ph ph-cloud-sun app-header__icon"></i>
          <h1 class="app-header__title">Smart <span class="weight-light">Weather</span></h1>
        </div>
        <p class="app-header__tagline">Atmospheric data, wind velocity, and solar tracking for any coordinates.</p>
      </header>

      <!-- Search Section (No container card, directly on background) -->
      <section class="search-section" id="searchSection">
        <form class="search-form" action="/" method="GET" id="searchForm">
          <!-- Hidden inputs for coordinates -->
          <input type="hidden" name="lat" id="latInput" />
          <input type="hidden" name="lon" id="lonInput" />
          <div class="search-input-wrapper">
            <i class="ph ph-map-pin search-input-wrapper__icon"></i>
            <input
              type="text"
              class="search-input"
              id="cityInput"
              name="city"
              placeholder="Enter city name…"
              value="<%= typeof city !== 'undefined' ? city : '' %>"
              autocomplete="off"
              required
            />
            <!-- Suggestions Dropdown -->
            <div class="search-suggestions" id="searchSuggestions" role="listbox"></div>
          </div>
          <button type="submit" class="search-btn" id="searchBtn">
            <i class="ph ph-magnifying-glass search-btn__icon"></i>
            Search
          </button>
        </form>

        <% if (typeof savedCities !== 'undefined' && savedCities && savedCities.length) { %>
          <div class="saved-cities" aria-label="Saved cities">
            <% savedCities.forEach(function(c) { %>
              <div class="city-chip<%= (typeof savedMatch !== 'undefined' && savedMatch && savedMatch.id === c.id) ? ' city-chip--active' : '' %>">
                <a class="city-chip__link js-nav"
                   href="/?city=<%= encodeURIComponent(c.name) %>&country=<%= encodeURIComponent(c.country) %>&lat=<%= c.latitude %>&lon=<%= c.longitude %>"
                   title="Load <%= c.name %>">
                  <i class="ph-fill ph-star city-chip__star"></i>
                  <%= c.name %><% if (c.country) { %><span class="city-chip__country"><%= c.country %></span><% } %>
                </a>
                <form action="/cities/<%= c.id %>/delete" method="POST" class="city-chip__delete-form">
                  <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                  <button type="submit" class="city-chip__delete" aria-label="Remove <%= c.name %> from saved cities" title="Remove">
                    <i class="ph ph-x"></i>
                  </button>
                </form>
              </div>
            <% }); %>
          </div>
        <% } %>
      </section>

      <!-- Error Alert -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-alert" role="alert" id="errorAlert">
          <i class="ph ph-warning-octagon error-alert__icon"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- Weather Results -->
      <% if (typeof weather !== 'undefined' && weather) { %>
        <section class="weather-results" id="weatherResults">

          <!-- Hero Card (Prominent & Distinct) -->
          <div class="weather-hero">
            <div class="weather-hero__location">
              <span class="weather-hero__city"><%= weather.city %></span>
              <% if (weather.country) { %><span class="weather-hero__country"><%= weather.country %></span><% } %>
              <% if (typeof savedCities !== 'undefined' && savedCities) { %>
                <% if (savedMatch) { %>
                  <form action="/cities/<%= savedMatch.id %>/delete" method="POST" class="star-form">
                    <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                    <button type="submit" class="star-btn star-btn--on" aria-label="Remove <%= weather.city %> from saved cities" title="Saved — click to remove">
                      <i class="ph-fill ph-star"></i>
                    </button>
                  </form>
                <% } else { %>
                  <form action="/cities" method="POST" class="star-form">
                    <input type="hidden" name="name" value="<%= weather.city %>" />
                    <input type="hidden" name="country" value="<%= weather.country %>" />
                    <input type="hidden" name="latitude" value="<%= weather.latitude %>" />
                    <input type="hidden" name="longitude" value="<%= weather.longitude %>" />
                    <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                    <button type="submit" class="star-btn" aria-label="Save <%= weather.city %>" title="Save this city">
                      <i class="ph ph-star"></i>
                    </button>
                  </form>
                <% } %>
              <% } %>
            </div>
            <p class="weather-hero__date"><%= weather.date %></p>
            <p class="weather-hero__freshness">
              <% if (weather.fromCache) { %>
                <i class="ph ph-database"></i> Cached · updated <%= weather.ageMinutes === 0 ? 'just now' : weather.ageMinutes + ' min ago' %>
              <% } else { %>
                <i class="ph ph-broadcast"></i> Live from Open-Meteo
              <% } %>
            </p>

            <div class="hero-stage" data-hero-3d data-model="<%= weather.scene.model %>" data-theme="<%= weather.theme %>">
              <canvas class="hero-stage__canvas" tabindex="0" role="img"
                      aria-label="3D <%= weather.description %> model — drag or use arrow keys to spin"></canvas>
              <div class="weather-hero__icon-wrapper hero-stage__fallback">
                <%- weather.iconSvg %>
              </div>
            </div>

            <div class="weather-hero__temp">
              <span class="data-mono"><%= weather.temp %></span><sup>°C</sup>
            </div>
            <p class="weather-hero__description"><%= weather.description %></p>
            <span class="weather-hero__feels-like">
              <i class="ph ph-thermometer"></i> Feels like <span class="data-mono"><%= weather.feels_like %></span>°C
            </span>
          </div>

          <!-- Hourly Forecast Strip -->
          <div class="hourly-forecast tilt-card" data-tilt="3">
            <h3 class="hourly-forecast__title">Hourly Forecast</h3>
            <div class="hourly-forecast__strip">
              <% weather.hourly.forEach(function(hour) { %>
                <div class="hourly-item">
                  <span class="hourly-item__time"><%= hour.time %></span>
                  <div class="hourly-item__icon-wrapper">
                    <%- hour.iconSvg %>
                  </div>
                  <span class="hourly-item__temp"><span class="data-mono"><%= hour.temp %></span>°</span>
                </div>
              <% }); %>
            </div>
          </div>

          <!-- Metrics Grid (Varying shadow/borders) -->
          <div class="metrics-grid">
            <div class="metric-card tilt-card" data-tilt="10">
              <i class="ph ph-drop metric-card__icon"></i>
              <div class="metric-card__value"><span class="data-mono"><%= weather.humidity %></span>%</div>
              <div class="metric-card__label">Humidity</div>
            </div>
            <div class="metric-card tilt-card" data-tilt="10">
              <i class="ph ph-wind metric-card__icon"></i>
              <div class="metric-card__value"><span class="data-mono"><%= weather.wind_speed %></span> km/h</div>
              <div class="metric-card__label">Wind Speed</div>
            </div>
            <div class="metric-card tilt-card" data-tilt="10">
              <i class="ph ph-gauge metric-card__icon"></i>
              <div class="metric-card__value"><span class="data-mono"><%= weather.pressure %></span> hPa</div>
              <div class="metric-card__label">Pressure</div>
            </div>
            <div class="metric-card tilt-card" data-tilt="10">
              <i class="ph ph-eye metric-card__icon"></i>
              <div class="metric-card__value"><span class="data-mono"><%= weather.visibility %></span> km</div>
              <div class="metric-card__label">Visibility</div>
            </div>
          </div>

          <!-- Outdoor / Laundry Suitability -->
          <% if (typeof suitability !== 'undefined' && suitability) { %>
            <div class="suitability suitability--<%= suitability.level %> tilt-card" data-tilt="3" id="suitability">
              <div class="suitability__header">
                <i class="ph-fill <%= suitability.level === 'good' ? 'ph-check-circle' : (suitability.level === 'fair' ? 'ph-warning-circle' : 'ph-x-circle') %> suitability__icon"></i>
                <div>
                  <h2 class="suitability__title">Outdoor &amp; Laundry</h2>
                  <p class="suitability__label"><%= suitability.label %></p>
                </div>
              </div>
              <ul class="suitability__checks">
                <% suitability.checks.forEach(function(chk) { %>
                  <li class="suitability__check <%= chk.ok ? 'is-ok' : 'is-fail' %>">
                    <i class="ph <%= chk.ok ? 'ph-check' : 'ph-x' %>"></i>
                    <span class="suitability__check-label"><%= chk.label %><% if (chk.note) { %> <em>— <%= chk.note %></em><% } %></span>
                    <span class="data-mono suitability__check-value"><%= chk.value %></span>
                    <span class="suitability__check-limit"><%= chk.limit %></span>
                  </li>
                <% }); %>
              </ul>
            </div>
          <% } %>

          <!-- Sun Schedule -->
          <div class="sun-schedule tilt-card" data-tilt="5">
            <h2 class="sun-schedule__title">Solar Schedule</h2>
            <div class="sun-schedule__row">
              <div class="sun-item">
                <i class="ph ph-sunrise sun-item__icon"></i>
                <span class="sun-item__time data-mono"><%= weather.sunrise %></span>
                <span class="sun-item__label">Sunrise</span>
              </div>
              <div class="sun-schedule__divider"></div>
              <div class="sun-item">
                <i class="ph ph-sunset sun-item__icon"></i>
                <span class="sun-item__time data-mono"><%= weather.sunset %></span>
                <span class="sun-item__label">Sunset</span>
              </div>
            </div>
          </div>

        </section>

      <% } else if (typeof error === 'undefined' || !error) { %>
        <!-- Welcome State -->
        <div class="welcome-state" id="welcomeState">
          <i class="ph ph-globe-hemisphere-east welcome-state__icon"></i>
          <h2 class="welcome-state__title">Discover Your Weather</h2>
          <p class="welcome-state__text">
            Enter a city name above to get real-time weather conditions, temperature, wind, humidity, and more.
          </p>
        </div>
      <% } %>

      <!-- Recent Searches -->
      <% if (typeof recentSearches !== 'undefined' && recentSearches && recentSearches.length) { %>
        <section class="panel recent-searches" id="recentSearches">
          <div class="panel__header">
            <h2 class="panel__title"><i class="ph ph-clock-counter-clockwise"></i> Recent Searches</h2>
            <form action="/history/clear" method="POST">
              <input type="hidden" name="returnTo" value="<%= returnTo %>" />
              <button type="submit" class="text-btn">Clear</button>
            </form>
          </div>
          <ul class="recent-list">
            <% recentSearches.forEach(function(r) { %>
              <li>
                <a class="recent-list__item js-nav"
                   href="/?city=<%= encodeURIComponent(r.name) %>&country=<%= encodeURIComponent(r.country) %>&lat=<%= r.latitude %>&lon=<%= r.longitude %>">
                  <span class="recent-list__name"><%= r.name %><% if (r.country) { %> <span class="recent-list__country"><%= r.country %></span><% } %></span>
                  <time class="recent-list__time" datetime="<%= new Date(r.searched_at).toISOString() %>"><%= new Date(r.searched_at).toISOString() %></time>
                </a>
              </li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <!-- Outdoor / Laundry Thresholds -->
      <% if (typeof dbAvailable !== 'undefined' && dbAvailable && preferences) { %>
        <details class="panel prefs" id="preferences">
          <summary class="panel__title prefs__summary">
            <i class="ph ph-sliders-horizontal"></i> My Outdoor Thresholds
            <span class="prefs__current data-mono"><%= preferences.max_wind_kmh %> km/h · <%= preferences.max_humidity_pct %>% RH · <%= preferences.max_rain_chance_pct %>% rain</span>
          </summary>
          <form action="/preferences" method="POST" class="prefs__form">
            <input type="hidden" name="returnTo" value="<%= returnTo %>" />
            <label class="prefs__field">
              <span>Max wind speed</span>
              <span class="prefs__input"><input type="number" name="max_wind_kmh" min="0" max="200" step="0.5" value="<%= preferences.max_wind_kmh %>" required /> km/h</span>
            </label>
            <label class="prefs__field">
              <span>Max humidity</span>
              <span class="prefs__input"><input type="number" name="max_humidity_pct" min="0" max="100" step="1" value="<%= preferences.max_humidity_pct %>" required /> %</span>
            </label>
            <label class="prefs__field">
              <span>Max rain chance (next 3h)</span>
              <span class="prefs__input"><input type="number" name="max_rain_chance_pct" min="0" max="100" step="1" value="<%= preferences.max_rain_chance_pct %>" required /> %</span>
            </label>
            <button type="submit" class="search-btn prefs__save"><i class="ph ph-floppy-disk"></i> Save thresholds</button>
          </form>
        </details>
      <% } %>

    </div>
  </div>

  <script>
    const form = document.getElementById('searchForm');
    const overlay = document.getElementById('loadingOverlay');
    const cityInput = document.getElementById('cityInput');
    const latInput = document.getElementById('latInput');
    const lonInput = document.getElementById('lonInput');
    const suggestionsContainer = document.getElementById('searchSuggestions');
    
    let debounceTimer;
    let currentController = null;
    let highlightedIndex = -1;
    let suggestionsData = [];

    // Show loading overlay when loading a saved city or recent search
    document.querySelectorAll('.js-nav').forEach((link) => {
      link.addEventListener('click', () => overlay && overlay.classList.add('active'));
    });

    // Render recent-search timestamps as relative times ("5 min ago")
    document.querySelectorAll('.recent-list__time').forEach((el) => {
      const then = new Date(el.getAttribute('datetime'));
      const mins = Math.round((Date.now() - then.getTime()) / 60000);
      let text;
      if (mins < 1) text = 'just now';
      else if (mins < 60) text = `${mins} min ago`;
      else if (mins < 1440) text = `${Math.round(mins / 60)} h ago`;
      else text = then.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
      el.textContent = text;
      el.title = then.toLocaleString();
    });

    // Show loading overlay on form submit
    if (form && overlay) {
      form.addEventListener('submit', () => {
        overlay.classList.add('active');
      });
    }

    if (cityInput && suggestionsContainer) {
      cityInput.addEventListener('input', (e) => {
        const query = e.target.value.trim();
        
        // Reset coordinates if query changes
        latInput.value = '';
        lonInput.value = '';
        
        clearTimeout(debounceTimer);
        
        if (query.length < 2) {
          hideSuggestions();
          return;
        }

        debounceTimer = setTimeout(() => {
          fetchSuggestions(query);
        }, 300);
      });

      cityInput.addEventListener('keydown', (e) => {
        const items = suggestionsContainer.querySelectorAll('.suggestion-item');
        if (!suggestionsContainer.classList.contains('active') || items.length === 0) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          highlightedIndex = (highlightedIndex + 1) % items.length;
          updateHighlight(items);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          highlightedIndex = (highlightedIndex - 1 + items.length) % items.length;
          updateHighlight(items);
        } else if (e.key === 'Enter') {
          if (highlightedIndex >= 0 && highlightedIndex < items.length) {
            e.preventDefault();
            selectSuggestion(suggestionsData[highlightedIndex]);
          }
        } else if (e.key === 'Escape') {
          e.preventDefault();
          hideSuggestions();
        }
      });

      document.addEventListener('click', (e) => {
        if (!cityInput.contains(e.target) && !suggestionsContainer.contains(e.target)) {
          hideSuggestions();
        }
      });
    }

    function updateHighlight(items) {
      items.forEach((item, index) => {
        if (index === highlightedIndex) {
          item.classList.add('highlighted');
          item.setAttribute('aria-selected', 'true');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('highlighted');
          item.removeAttribute('aria-selected');
        }
      });
    }

    async function fetchSuggestions(query) {
      if (currentController) {
        currentController.abort();
      }

      currentController = new AbortController();
      const signal = currentController.signal;

      try {
        const url = `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=5`;
        const response = await fetch(url, { signal });
        
        if (!response.ok) {
          hideSuggestions();
          return;
        }

        const data = await response.json();
        
        if (!data.results || data.results.length === 0) {
          hideSuggestions();
          return;
        }

        suggestionsData = data.results;
        renderSuggestions(data.results);
      } catch (error) {
        if (error.name !== 'AbortError') {
          hideSuggestions();
        }
      }
    }

    function renderSuggestions(results) {
      suggestionsContainer.innerHTML = '';
      highlightedIndex = -1;

      results.forEach((result, index) => {
        const item = document.createElement('div');
        item.className = 'suggestion-item';
        item.role = 'option';
        item.id = `suggestion-option-${index}`;

        const name = result.name;
        const region = result.admin1 ? `, ${result.admin1}` : '';
        const country = result.country_code ? `, ${result.country_code}` : '';
        
        item.innerHTML = `
          <i class="ph ph-map-pin" style="color: var(--color-text-muted);"></i>
          <span class="suggestion-item__text"><strong>${name}</strong>${region}${country}</span>
        `;

        item.addEventListener('click', () => {
          selectSuggestion(result);
        });

        suggestionsContainer.appendChild(item);
      });

      suggestionsContainer.classList.add('active');
    }

    function selectSuggestion(result) {
      const region = result.admin1 ? `, ${result.admin1}` : '';
      const country = result.country_code ? `, ${result.country_code}` : '';
      
      cityInput.value = `${result.name}${region}${country}`;
      latInput.value = result.latitude;
      lonInput.value = result.longitude;
      
      hideSuggestions();
      
      if (overlay) {
        overlay.classList.add('active');
      }
      form.submit();
    }

    function hideSuggestions() {
      suggestionsContainer.classList.remove('active');
      suggestionsContainer.innerHTML = '';
      highlightedIndex = -1;
      suggestionsData = [];
    }
  </script>

  <script src="/js/ambient.js" defer></script>
  <% if (typeof weather !== 'undefined' && weather && weather.scene) { %>
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.js",
          "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.169.0/examples/jsm/"
        }
      }
    </script>
    <script type="module" src="/js/hero3d.js"></script>
  <% } %>

<%- include('partials/footer') %>
