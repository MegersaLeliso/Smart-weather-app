# Copy to .env and fill in your local PostgreSQL credentials.
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=weather_db

# Minutes an Open-Meteo forecast stays cached in weather_cache
CACHE_TTL_MINUTES=20

# Web Push (VAPID) for Pack & Wear alarms - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI sent to push services (mailto: or https:, not localhost)
VAPID_SUBJECT=https://your-app.example.com
